    // ---- 撮影リクエスト（熱量 1〜5。1 利用者の合計も 5 まで）----
    // リクエストは 1 件ずつ requests/{id} に置き、同じバッチで heatBudgets/{uid} を
    // { used: 使った熱量の合計, target: <リクエスト ID> } に更新させる。
    // リクエスト側は「印が自分を指していること」、印側は「増えた分がリクエストの熱量と一致し、5 を超えないこと」を見る。
    // 取り下げ（本人の論理削除）も同じで、印を減らし、減った分が取り下げたリクエストの熱量と一致することを見る。熱量はその分戻る。
    // 地点ごとの集計（合計・件数）は画面と日次の同期がまとめる。

    function validRequest(d) {
      return d.keys().hasOnly([
          'lat', 'lng', 'heat', 'season', 'timeOfDay', 'style', 'equipment',
          'ownerUid', 'createdAt', 'updatedAt', 'withdrawn'])
        && d.keys().hasAll(['lat', 'lng', 'heat', 'equipment', 'ownerUid', 'createdAt', 'updatedAt'])
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.heat is int && d.heat >= 1 && d.heat <= 5
        // 季節・時間帯・撮り方は動画のタグと同じキー（ADR 0014）。未選択は項目ごと省く
        && optEnum(d, 'season', ['spring', 'summer', 'autumn', 'winter'])
        && optEnum(d, 'timeOfDay', ['sunrise', 'morning', 'daytime', 'evening', 'night'])
        && optEnum(d, 'style', ['aerial', 'walking', 'vehicle', 'fixed'])
        && validEquipment(d.equipment)
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    match /requests/{requestId} {
      allow read: if true;
      allow create: if canWrite()
        && registered()
        && validRequest(request.resource.data)
        && request.resource.data.get('withdrawn', false) == false
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(docPath('heatBudgets', request.auth.uid)).data.target == requestId;
      // 取り下げは論理削除（ADR 0013）: 本人か管理者が withdrawn と updatedAt だけを変え、
      // 持ち主の熱量の印を同じバッチで減らす（管理者の取り下げでも、持ち主の熱量はその分戻る）。
      // 物理削除すると、同期より前に作られた行の取り下げが差分の購読に届かないため。
      allow update: if canWrite()
        && (resource.data.ownerUid == request.auth.uid || isAdmin())
        && resource.data.get('withdrawn', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['withdrawn', 'updatedAt'])
        && request.resource.data.withdrawn == true
        && request.resource.data.updatedAt == request.time
        && getAfter(docPath('heatBudgets', resource.data.ownerUid)).data.target == requestId
        // 印が同じバッチでこの熱量ぶん減っていること。印が最初からこのリクエストを指している
        // （最後に作ったリクエスト）とき、印を書かずに取り下げだけを通して熱量を戻らなくするのを防ぐ
        && get(docPath('heatBudgets', resource.data.ownerUid)).data.used
          - getAfter(docPath('heatBudgets', resource.data.ownerUid)).data.used == resource.data.heat;
      // 物理削除は管理者だけ（削除したら同期で公開データを作り直す）
      allow delete: if canWrite() && isAdmin();
    }

    // この書き込みで新しく作られたリクエストが本人のもので、熱量が delta と一致するか
    function pairedRequest(uid, target, delta) {
      let path = docPath('requests', target);
      return !exists(path)
        && existsAfter(path)
        && getAfter(path).data.ownerUid == uid
        && getAfter(path).data.heat == delta;
    }

    // この書き込みで取り下げられた（withdrawn が false から true になった）本人のリクエストで、熱量が delta と一致するか
    function withdrawnRequest(uid, target, delta) {
      let path = docPath('requests', target);
      return exists(path)
        && get(path).data.get('withdrawn', false) == false
        && getAfter(path).data.get('withdrawn', false) == true
        && get(path).data.ownerUid == uid
        && get(path).data.heat == delta;
    }

    function budgetShape() {
      let d = request.resource.data;
      return canWrite()
        && d.keys().hasOnly(['used', 'target'])
        && d.used is int && d.used >= 0 && d.used <= 5
        && reqString(d, 'target', 1, 128);
    }

    // 増やす（リクエストの作成）のは本人だけ。減らす（取り下げ）のは本人か管理者（管理者の取り下げ。要件 5.2.5）。
    // どちらも差分が対象のリクエストの熱量と一致すること
    function validBudget(uid, before) {
      let d = request.resource.data;
      return budgetShape()
        && ((request.auth.uid == uid && d.used > before && pairedRequest(uid, d.target, d.used - before))
          || ((request.auth.uid == uid || isAdmin()) && d.used < before
            && withdrawnRequest(uid, d.target, before - d.used)));
    }

    match /heatBudgets/{uid} {
      // 管理者は、取り下げで減らす値を求めるために読む
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if validBudget(uid, 0);
      allow update: if validBudget(uid, resource.data.used);
      // 消して上限をリセットさせない
      allow delete: if false;
    }
