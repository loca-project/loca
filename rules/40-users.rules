    // ---- プロフィール（要件 1.1・2.5・2.6・ADR 0019）----
    // users/{uid}。uid は Firebase Auth の uid なので Google アカウントに紐づく。
    // 持つのはニックネームと同意の記録だけ（メールや本名は保存しない）。読めるのは本人と管理者。

    // 索引（nicknames/{キー}）の文書 ID に使えない形（/ を含む・. と ..・__ で囲む）も拒否する
    function validNickname(d) {
      return d.nickname is string
        && d.nickname.size() >= 1 && d.nickname.size() <= 20
        && d.nickname.matches('[^\\r\\n/]+')
        && d.nickname.trim() == d.nickname
        && !(d.nickname in ['.', '..'])
        && !d.nickname.matches('__.*__');
    }

    // ---- ニックネームの重複の禁止（ADR 0019 決定 9）----
    // nicknames/{キー} = { uid }。キーはニックネームを小文字にしたもの（大文字小文字だけの違いも同じ名前とみなす）。
    // 作成は無いときだけ通るので、同じ名前は 1 人しか持てない。プロフィールの登録・変更と同じバッチで作らせる。

    function nicknameKey(nickname) {
      return nickname.lower();
    }

    // この書き込みのあと、nickname の索引が uid のものになっているか
    function holdsNickname(uid, nickname) {
      let path = docPath('nicknames', nicknameKey(nickname));
      return existsAfter(path) && getAfter(path).data.uid == uid;
    }

    // 名前を変えたら、古い名前の索引を同じバッチで手放す（買い占めさせない）
    function releasedOld(uid) {
      let before = nicknameKey(resource.data.nickname);
      let path = docPath('nicknames', before);
      return before == nicknameKey(request.resource.data.nickname)
        || !existsAfter(path)
        || getAfter(path).data.uid != uid;
    }

    match /nicknames/{key} {
      // 登録前に「使われているか」を確かめるため、ログイン済みなら 1 件ずつ読める（一覧は出さない）
      allow get: if signedIn();
      allow list: if false;
      allow create: if canWrite()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && key == nicknameKey(getAfter(docPath('users', request.auth.uid)).data.nickname);
      allow update: if false;
      // 本人は、いまのニックネームでなくなった索引だけ手放せる（アカウント削除でプロフィールを消すときも手放せる）
      allow delete: if canWrite() && (
        isAdmin()
        || (resource.data.uid == request.auth.uid
          && (!existsAfter(docPath('users', request.auth.uid))
            || key != nicknameKey(getAfter(docPath('users', request.auth.uid)).data.nickname)))
      );
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // 同意は全項目そろったときだけ作れる（画面が全部の印を求める）。同意の版と日時を記録する
      allow create: if canWrite()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname', 'consentVersion', 'agreedAt', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['nickname', 'consentVersion', 'agreedAt', 'createdAt', 'updatedAt'])
        && validNickname(request.resource.data)
        && request.resource.data.consentVersion == 1
        && holdsNickname(uid, request.resource.data.nickname)
        && request.resource.data.agreedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // 本人が変えられるのはニックネームだけ（要件 2.6）。変えるたびに本人のマーカーの投稿者名も書き換えるので、
      // 付け替えの繰り返しで書き込みを増やされないよう、前の登録・変更から 60 秒あける
      allow update: if canWrite()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'updatedAt'])
        && validNickname(request.resource.data)
        && holdsNickname(uid, request.resource.data.nickname)
        && releasedOld(uid)
        && request.resource.data.updatedAt == request.time
        && request.time > resource.data.updatedAt + duration.value(60, 's');
      // アカウント削除（要件 2.7・ADR 0021）。本人は自分のプロフィールを消せる。投稿は先に論理削除する（画面が順に行う）
      allow delete: if canWrite() && (isAdmin() || request.auth.uid == uid);
    }

    // ---- 管理者とブラックリスト（要件 5.x）----
    // 追加・削除は管理者だけ。本人は自分の行があるかどうかだけ読める（表示の切り替え用）

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if canWrite() && isAdmin();
    }

    // 定期処理の記録（ADR 0017）。Actions が IAM の経路で書き、管理者だけが読む
    match /jobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /blacklist/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if canWrite() && isAdmin();
    }
  }
}
