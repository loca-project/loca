{
  "name": "loca",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Loca - 地図に残す、あの場所の記録（GitHub Pages で動く静的サイト）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "check": "npm run typecheck && npm run build && npm run verify && npm run test:scripts",
    "test:scripts": "node --test tests/scripts/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-loca \"node --test --test-concurrency=1 tests/rules/*.test.mjs tests/store/*.test.mjs\"",
    "deploy:rules": "npm run test:rules && firebase deploy --only firestore:rules --project loca-d3792 && npm run rules:probe",
    "rules:probe": "node scripts/probe-rules.mjs",
    "pages:wait": "node scripts/wait-pages.mjs",
    "admin:list": "node scripts/admins.mjs list",
    "admin:add": "node scripts/admins.mjs add",
    "admin:remove": "node scripts/admins.mjs remove",
    "migrate:video-index": "node scripts/migrate-video-index.mjs",
    "data:seed": "node scripts/make-seed-data.mjs",
    "data:clear": "node scripts/clear-data.mjs",
    "data:ingest": "node scripts/ingest-issue.mjs",
    "data:sync": "node scripts/sync-firestore.mjs",
    "data:sync:check": "node scripts/sync-firestore.mjs --check",
    "data:reset": "node scripts/reset-data.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "firebase": "^12.19.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "^15.30.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
