{
  "name": "loca",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Loca - 地図に残す、あの場所の記録（GitHub Pages で動く静的サイト）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "check": "npm run typecheck && npm run build && npm run verify",
    "smoke": "node scripts/smoke.mjs",
    "data:seed": "node scripts/make-seed-data.mjs",
    "data:clear": "node scripts/clear-data.mjs",
    "data:ingest": "node scripts/ingest-issue.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
