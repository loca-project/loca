# ============================================================
# Loca 環境変数テンプレート
#   cp .env.example .env.local して使う。.env* は git 管理外。
#   すべて未設定でもサイトは動く（投稿導線だけが出なくなる）。
# ============================================================

# --- 投稿先の GitHub リポジトリ -------------------------------
# owner/repo 形式。未設定だと投稿ボタンが出ない。
# GitHub Actions でビルドする場合は自動で設定されるので、
# ここで指定するのはローカル確認のときだけでよい。
VITE_GITHUB_REPO=

# --- 公開データの置き場（index.html からの相対）----------------
VITE_DATA_BASE_URL=./data

# --- 配信先のベースパス ----------------------------------------
# 未設定なら './'（相対）。GitHub Pages はこのままでよい。
VITE_BASE_PATH=
